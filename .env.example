# BuildConnect Environment Configuration Template
# Copy this file to .env and fill in environment-specific credentials for production.

# Application Metainfo
APP_NAME=BuildConnect
APP_ENV=production
APP_DEBUG=false

# Database Configuration (MySQL / PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buildconnect
DB_USER=root
DB_PASS=

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# AI Service Engine Configuration
AI_ENABLED=true
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google-callback.php

